<plist version="1.0">
<dict>
    <key>Label</key><string>org.betasdc.nginx-8443</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/nginx</string>
        <string>-e</string><string>stderr</string>
        <string>-p</string>
        <string>/Users/jietexue/Library/Application Support/BetasdcDemo/nginx/</string>
