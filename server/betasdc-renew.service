[Unit]
Description=Renew Betasdc DNS-validated certificates
After=network-online.target
Wants=network-online.target
OnSuccess=betasdc-certificates.service

[Service]
Type=oneshot
User=betasdc-acme
Group=betasdc-acme
Environment=HOME=/var/lib/betasdc-acme
Environment=BETASDC_ACME_HOME=/var/lib/betasdc-acme
ExecStart=/bin/sh /opt/betasdc/renew-certificate.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/betasdc-acme
RestrictSUIDSGID=true
CapabilityBoundingSet=
MemoryMax=128M
TasksMax=32
TimeoutStartSec=20min
